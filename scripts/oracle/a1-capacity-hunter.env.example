# Copy to scripts/oracle/a1-capacity-hunter.env and fill in local values.
# Do not commit the filled-in file.

# OCI CLI profile/region. Leave profile as DEFAULT if you used `oci setup config`.
OCI_PROFILE=DEFAULT
OCI_REGION=us-sanjose-1

# Tenancy/root compartment OCID. Used to list availability domains.
OCI_TENANCY_ID=ocid1.tenancy.oc1..replace-me

# Compartment where the instance should be created. This may be the tenancy OCID
# if you are creating instances in the root compartment.
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-me

# Public subnet OCID for the new VM.
OCI_SUBNET_ID=ocid1.subnet.oc1.us-sanjose-1.replace-me

# ARM-compatible image OCID for the selected region, such as Oracle Linux or
# Ubuntu aarch64. The image must support VM.Standard.A1.Flex.
OCI_IMAGE_ID=ocid1.image.oc1.us-sanjose-1.replace-me

# Public SSH key to install on the new VM. Use a .pub file, not the private key.
OCI_SSH_PUBLIC_KEY_FILE=$HOME/.ssh/oracle_audiotool_score_io.pub

# Candidate availability domains. Leave blank to let the script query them.
# You can also provide a comma-separated list, for example:
# OCI_AVAILABILITY_DOMAINS=GwkO:US-SANJOSE-1-AD-1,GwkO:US-SANJOSE-1-AD-2
OCI_AVAILABILITY_DOMAINS=

# Instance shape settings. 1 OCPU / 6 GB is a good first target and much better
# than the E2 micro VM. Increase later if capacity allows.
OCI_DISPLAY_NAME=audiotool-score-io-a1
OCI_OCPUS=1
OCI_MEMORY_GBS=6
OCI_BOOT_VOLUME_GBS=50

# Retry behavior. Set OCI_MAX_ATTEMPTS=0 to retry forever.
OCI_SLEEP_SECONDS=1800
OCI_MAX_ATTEMPTS=0

# Optional log directory. Leave blank to use tmp/oracle inside this repo.
# For a macOS LaunchAgent, use a non-Documents path such as:
# OCI_LOG_DIR=$HOME/Library/Logs/audiotool-score-io
OCI_LOG_DIR=

# Set true to print the launch commands without creating an instance.
OCI_DRY_RUN=false
