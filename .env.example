# Server
PORT=3000

# Docker Compose host ports
API_PORT=3000
WEB_PORT=8080

# MuseScore
# Leave blank to search PATH for mscore, mscore4, musescore, musescore3, or musescore4.
MUSESCORE_BIN=

# auto: use xvfb-run on Linux when DISPLAY is missing
# always: always wrap MuseScore with xvfb-run
# never: run MuseScore directly
MUSESCORE_USE_XVFB=auto
XVFB_RUN_BIN=xvfb-run

# Limits and timeouts
MAX_UPLOAD_BYTES=52428800
JSON_BODY_LIMIT=1mb
CONVERSION_TIMEOUT_MS=120000

# MIDI preprocessing
# Supported values: 4, 8, 12, 16, 24, 32, 48, 64
DEFAULT_QUANTIZATION_GRID=48

# Audiotool
# Register an application at https://developer.audiotool.com/applications.
# For local Vite dev, add http://127.0.0.1:5173/ as a redirect URI.
# For Docker Compose, add http://127.0.0.1:8080/ unless WEB_PORT is changed.
VITE_AUDIOTOOL_CLIENT_ID=
# Leave blank to use the browser's current origin, e.g. http://127.0.0.1:8080/
# for Docker Compose or http://127.0.0.1:5173/ for Vite dev.
VITE_AUDIOTOOL_REDIRECT_URL=
VITE_AUDIOTOOL_SCOPE=project:read

# Optional API-side client ID fallback for browser-exported OAuth tokens.
AUDIOTOOL_CLIENT_ID=

# Optional server-side Personal Access Token for API scripts or backend-only demos.
# The browser app uses Audiotool OAuth instead.
AUDIOTOOL_PAT=
