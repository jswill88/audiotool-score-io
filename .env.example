# Server
PORT=3000

# Docker Compose host ports
API_PORT=3000
WEB_PORT=5173

# Limits
MAX_UPLOAD_BYTES=52428800
JSON_BODY_LIMIT=1mb

# Split deployments
# Comma-separated browser origins allowed to call the API directly, for example:
# CORS_ORIGINS=https://your-web-host.example
CORS_ORIGINS=

# Audiotool
# Register an application at https://developer.audiotool.com/applications.
# For local Vite dev, add http://127.0.0.1:5173/ as a redirect URI.
# For Docker Compose, add http://127.0.0.1:5173/ unless WEB_PORT is changed.
VITE_AUDIOTOOL_CLIENT_ID=
# Leave blank to use the browser's current origin, e.g. http://127.0.0.1:5173/.
VITE_AUDIOTOOL_REDIRECT_URL=
VITE_AUDIOTOOL_SCOPE=project:write

# Optional API-side client ID fallback for browser-exported OAuth tokens.
AUDIOTOOL_CLIENT_ID=

# Optional server-side Personal Access Token for API scripts or backend-only demos.
# The browser app uses Audiotool OAuth instead.
AUDIOTOOL_PAT=
