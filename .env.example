# Server
PORT=3000

# MuseScore
# Leave blank to search PATH for mscore, mscore4, musescore, musescore3, or musescore4.
MUSESCORE_BIN=

# auto: use xvfb-run on Linux when DISPLAY is missing
# always: always wrap MuseScore with xvfb-run
# never: run MuseScore directly
MUSESCORE_USE_XVFB=auto
XVFB_RUN_BIN=xvfb-run

# Limits and timeouts
MAX_UPLOAD_BYTES=52428800
CONVERSION_TIMEOUT_MS=120000

# MIDI preprocessing
# Supported values: 4, 8, 12, 16, 24, 32, 48, 64
DEFAULT_QUANTIZATION_GRID=48
